# ============================================================
# Fire Within University — Environment Variables
# ============================================================
# SETUP: Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file with real secrets to git.
# ============================================================

# --- Sanity CMS ---
# Found in sanity.io > your project > Settings > API
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id_here
NEXT_PUBLIC_SANITY_DATASET=production
# Read-only token for public content fetching (frontend)
SANITY_API_READ_TOKEN=your_read_only_sanity_token_here
# Write token for server-side mutations only (never expose to browser)
SANITY_API_WRITE_TOKEN=your_write_sanity_token_here

# --- Stripe ---
# Found in dashboard.stripe.com > Developers > API keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
# Found in Stripe dashboard > Developers > Webhooks > your endpoint
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# --- Site URL (used for Stripe redirect URLs) ---
# In production: https://www.firewithinuniversity.com
# In development: http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Google Analytics ---
# Found in GA4 > Admin > Data Streams > your stream > Measurement ID
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# --- Contact Form ---
# The email address where contact/prayer request form submissions are delivered
# Use a transactional email service (Resend or SendGrid) — not your personal inbox
CONTACT_FORM_EMAIL=your_ministry_email@example.com
# Resend API key (or SendGrid) — for sending contact form emails
RESEND_API_KEY=re_your_resend_api_key_here

# --- NextAuth ---
NEXTAUTH_SECRET=generate_a_random_32_char_secret_here
NEXTAUTH_URL=http://localhost:3000

# --- Admin Accounts ---
# Generate password hashes with: npx tsx scripts/hash-password.ts <password>
ADMIN_EMAIL_1=admin@example.com
ADMIN_PASSWORD_1=your_bcrypt_hash_here
ADMIN_EMAIL_2=admin2@example.com
ADMIN_PASSWORD_2=your_bcrypt_hash_here

# --- Google OAuth ---
# Found in Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# --- Database (Prisma + Neon PostgreSQL) ---
# Get your connection string from neon.tech > your project > Connection Details
DATABASE_URL=postgresql://user:password@ep-something.us-east-1.aws.neon.tech/neondb?sslmode=require

# --- Cron (Vercel Cron + external pinger) ---
# Protects /api/cron/* endpoints. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must also be set in the Vercel project env so Vercel Cron sends it as a Bearer token.
CRON_SECRET=a_long_random_hex_string_here
