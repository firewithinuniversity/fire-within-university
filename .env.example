# ============================================================
# Fire Within University — Environment Variables
# ============================================================
# SETUP: Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file with real secrets to git.
# ============================================================

# --- Sanity CMS ---
# Found in sanity.io > your project > Settings > API
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id_here
NEXT_PUBLIC_SANITY_DATASET=production
# Read-only token for public content fetching (frontend)
SANITY_API_READ_TOKEN=your_read_only_sanity_token_here
# Write token for server-side mutations only (never expose to browser)
SANITY_API_WRITE_TOKEN=your_write_sanity_token_here
# Secret token to protect Sanity preview mode
SANITY_PREVIEW_SECRET=a_long_random_string_here

# --- Stripe ---
# Found in dashboard.stripe.com > Developers > API keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
# Found in Stripe dashboard > Developers > Webhooks > your endpoint
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# --- Mailchimp ---
# Found in Mailchimp > Account > Extras > API Keys
MAILCHIMP_API_KEY=your_mailchimp_api_key_here
# Found in Mailchimp > Audience > Settings > Audience name and defaults
MAILCHIMP_AUDIENCE_ID=your_audience_id_here
# The server prefix (e.g. "us21") from your Mailchimp API key — the part after the dash
MAILCHIMP_SERVER_PREFIX=us21

# --- Site URL (used for Stripe redirect URLs) ---
# In production: https://www.firewithinuniversity.com
# In development: http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Google Analytics ---
# Found in GA4 > Admin > Data Streams > your stream > Measurement ID
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# --- Contact Form ---
# The email address where contact/prayer request form submissions are delivered
# Use a transactional email service (Resend or SendGrid) — not your personal inbox
CONTACT_FORM_EMAIL=your_ministry_email@example.com
# Resend API key (or SendGrid) — for sending contact form emails
RESEND_API_KEY=re_your_resend_api_key_here
